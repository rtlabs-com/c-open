#ifndef VERSION_H
#define VERSION_H

#cmakedefine COPEN_GIT_REVISION "@COPEN_GIT_REVISION@"

#if !defined(CO_VERSION_BUILD) && defined(COPEN_GIT_REVISION)
#define CO_VERSION_BUILD COPEN_GIT_REVISION
#endif

/* clang-format-off */

#define CO_VERSION_MAJOR @COPEN_VERSION_MAJOR@
#define CO_VERSION_MINOR @COPEN_VERSION_MINOR@
#define CO_VERSION_PATCH @COPEN_VERSION_PATCH@

#if defined(CO_VERSION_BUILD)
#define CO_VERSION \
   "@COPEN_VERSION_MAJOR@.@COPEN_VERSION_MINOR@.@COPEN_VERSION_PATCH@+"CO_VERSION_BUILD
#else
#define CO_VERSION \
   "@COPEN_VERSION_MAJOR@.@COPEN_VERSION_MINOR@.@COPEN_VERSION_PATCH@"
#endif

/* clang-format-on */

#endif /* VERSION_H */
